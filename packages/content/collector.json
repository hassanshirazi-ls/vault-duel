{
  "deck": [
    "gilded-penitent", "ossuary-seraph", "saint-of-brass", "mourning-cartographer", "stormglass-hydra",
    "ashen-duchess", "kiln-born-leviathan", "drowned-choir", "abyssal-curator", "reliquary-hound",
    "velvet-moth-sovereign", "weeping-automaton", "the-unpriced",
    "provenance-ledger", "restoration", "gilt-frame", "forfeit",
    "display-case", "counterfeit", "insurance-claim"
  ],
  "ace": "the-unpriced",
  "canGraft": false,
  "ai": {
    "allowFaceDown": true,
    "reposition": "laneAware",
    "play": ["winThisTurn", "summonAce", "summonBeater", "setTrapWhenBehind", "castHighValueSpell", "summonFallback", "utility"],
    "attack": ["lethal", "killWithoutLoss", "faceDownIfStrong", "directIfEmpty", "holdExceptVain"],
    "params": {
      "setTrapWhenBehind": { "compare": "fewer" },
      "summonFallback": { "position": "attack", "slowPosition": "guard", "slowPick": "highestGuard" },
      "faceDownIfStrong": { "minPower": "$AI_FACEDOWN_ATTACK_MIN_POWER" },
      "killWithoutLoss": { "allowTrades": false },
      "castHighValueSpell": {
        "forfeit": { "pick": "highestPower" },
        "restoration": { "pick": "highestPower" },
        "gilt-frame": { "when": "contestedAttack" }
      },
      "summonBeater": { "compare": "previewAttack", "skipBrittleCountered": false },
      "utility": { "order": ["castDrawSpell", "setTrap", "pass"] },
      "summonLane": ["sentinelCenter", "facingBeatable", "facingEmpty", "leftmostFree"]
    },
    "moods": {
      "composed": {
        "params": { "setTrapWhenBehind": { "compare": "fewerOrEqual" }, "summonFallback": { "position": "guardUnlessBeater" } },
        "attack": ["lethal", "killWithoutLoss", "directIfEmpty", "holdExceptVain"]
      },
      "agitated": {
        "play": ["winThisTurn", "summonAce", "castHighValueSpell", "summonBeater", "setTrapWhenBehind", "summonFallback", "utility"],
        "params": { "killWithoutLoss": { "allowTrades": true } }
      },
      "desperate": {
        "attack": ["lethal", "attackAnything"],
        "params": { "faceDownIfStrong": { "minPower": 0 } },
        "reposition": "allAttack"
      }
    },
    "trapPreference": ["display-case", "insurance-claim", "counterfeit"],
    "tieBreak": ["leftmostSlot", "cardId", "instanceId"]
  },
  "dialogue": {
    "composed": [
      "Kneel. Your strongest will serve the crown soon enough.",
      "I have reigned longer than your bloodline has had a name.",
      "Set your monsters down. Every subject pays the levy in time.",
      "Such fine soldiers. They would look splendid at my side."
    ],
    "agitated": [
      "You forget whose soil you bleed on.",
      "That one. The crown is owed, and I collect.",
      "Your rabble is at my gates. Let them come.",
      "I will take your strongest, and you will watch it bow."
    ],
    "desperate": [
      "A crown does not fall to peasants.",
      "No more courtesy. Everything in this kingdom is mine to levy.",
      "Your hand is empty and your banners are torn. Let us finish this.",
      "Then let the whole court burn with me."
    ],
    "levy": [
      "Your champion swears to me now.",
      "Rise, soldier. You serve a greater house.",
      "Kneel, and take my crown upon your brow.",
      "Another banner for my hall."
    ]
  }
}
